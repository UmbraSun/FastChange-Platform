<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="UI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UI.ViewModels"
    x:DataType="viewModels:LoginViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource ExchangeBg}">

    <ScrollView>
        <Grid
            Padding="24"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
            RowSpacing="20">

            <!-- Header -->
            <VerticalStackLayout
                Grid.Row="0"
                Margin="0,48,0,20"
                Spacing="8">

                <Label
                    Text="FastChange"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource ExchangeGold}" />

                <Label
                    Text="Welcome back"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="Sign in to continue"
                    FontSize="15"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout
                Grid.Row="1"
                Spacing="8">

                <Label
                    Text="Email"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeText}" />

                <Entry
                    Text="{Binding Email}"
                    Placeholder="Enter your email"
                    Keyboard="Email"
                    ClearButtonVisibility="WhileEditing"
                    ReturnType="Next"
                    HeightRequest="52" />

            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout
                Grid.Row="2"
                Spacing="8">

                <Label
                    Text="Password"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeText}" />

                <Entry
                    Text="{Binding Password}"
                    Placeholder="Enter your password"
                    IsPassword="True"
                    ReturnType="Done"
                    ReturnCommand="{Binding LoginCommand}"
                    HeightRequest="52" />

            </VerticalStackLayout>

            <!-- Error -->
            <Label
                Grid.Row="3"
                Text="{Binding ErrorMessage}"
                TextColor="#F6465D"
                FontSize="14"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- Sign in -->
            <Button
                Grid.Row="4"
                Text="Sign In"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                HeightRequest="52"
                CornerRadius="12"
                BackgroundColor="{DynamicResource ExchangeGold}"
                TextColor="{DynamicResource ExchangeBg}"
                FontSize="16"
                FontAttributes="Bold" />

            <!-- Register link -->
            <HorizontalStackLayout
                Grid.Row="5"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Spacing="5">

                <Label
                    Text="Don't have an account?"
                    TextColor="{DynamicResource ExchangeMuted}"
                    FontSize="14"
                    VerticalTextAlignment="Center" />

                <Label
                    Text="Create account"
                    TextColor="{DynamicResource ExchangeGold}"
                    FontSize="14"
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenRegisterCommand}" />
                    </Label.GestureRecognizers>

                </Label>

            </HorizontalStackLayout>

        </Grid>
    </ScrollView>

</ContentPage>