<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Views.Sections.Home.AssistantPreviewView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Padding="18"
        BackgroundColor="{DynamicResource ExchangeCard}"
        Stroke="{DynamicResource ExchangeBorder}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 20">

        <VerticalStackLayout Spacing="14">

            <Label
                Text="FastChange Assistant"
                FontFamily="{DynamicResource Headline}"
                FontSize="18"
                TextColor="{DynamicResource ExchangeText}" />

            <Label
                Text="Your personal financial assistant"
                FontFamily="{DynamicResource Body}"
                FontSize="14"
                TextColor="{DynamicResource ExchangeMuted}" />

            <Label
                Text="Ask about your balance, transactions, currencies or exchange rates."
                FontFamily="{DynamicResource Body}"
                FontSize="13"
                LineBreakMode="WordWrap"
                TextColor="{DynamicResource ExchangeMuted}" />

            <Button
                Text="Ask Assistant"
                Clicked="AskAssistant_Clicked"
                BackgroundColor="{DynamicResource ExchangeGold}"
                TextColor="#000000"
                FontFamily="{DynamicResource Headline}"
                FontSize="14"
                CornerRadius="14"
                HeightRequest="46" />

        </VerticalStackLayout>
    </Border>
</ContentView>