<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Views.Sections.Home.RecentActivityView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    xmlns:viewModels="clr-namespace:UI.ViewModels">

    <!-- Recent Activity -->
    <Border
        Padding="18"
        BackgroundColor="{DynamicResource ExchangeCard}"
        Stroke="{DynamicResource ExchangeBorder}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 18">

        <Grid RowDefinitions="Auto,Auto">

            <Label
                Grid.Row="0"
                Text="Recent Activity"
                FontFamily="{DynamicResource Title}"
                FontSize="18"
                Margin="0,0,0,16"
                TextColor="{DynamicResource ExchangeText}" />

            <!-- Error -->
            <Border
                Grid.Row="1"
                Padding="14"
                BackgroundColor="#15191D"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                IsVisible="{Binding IsRecentActivityErrorVisible}">

                <Label
                    Text="{Binding RecentActivityErrorMessage}"
                    FontFamily="{DynamicResource Body}"
                    FontSize="13"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </Border>

            <!-- Empty -->
            <Border
                Grid.Row="1"
                Padding="14"
                BackgroundColor="#15191D"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                IsVisible="{Binding IsRecentActivityEmpty}">

                <Label
                    Text="No recent activity."
                    FontFamily="{DynamicResource Body}"
                    FontSize="13"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </Border>

            <!-- Activity list -->
            <VerticalStackLayout
                Grid.Row="1"
                Spacing="14"
                BindableLayout.ItemsSource="{Binding RecentActivity}"
                IsVisible="{Binding HasRecentActivity}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:RecentActivityItemViewModel">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                                <Label
                                    Text="{Binding Type}"
                                    FontFamily="{DynamicResource Body}"
                                    FontSize="14"
                                    TextColor="{DynamicResource ExchangeText}" />

                                <Label
                                    Text="{Binding DisplayDate}"
                                    FontFamily="{DynamicResource Body}"
                                    FontSize="12"
                                    TextColor="{DynamicResource ExchangeMuted}" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="{Binding DisplayAmount}"
                                FontFamily="{DynamicResource Body}"
                                FontSize="13"
                                VerticalOptions="Center"
                                HorizontalTextAlignment="End">

                                <Label.Triggers>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsPositive}"
                                        Value="True">

                                        <Setter
                                            Property="TextColor"
                                            Value="#22C55E" />

                                    </DataTrigger>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsNegative}"
                                        Value="True">

                                        <Setter
                                            Property="TextColor"
                                            Value="#EF4444" />

                                    </DataTrigger>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsNeutral}"
                                        Value="True">

                                        <Setter
                                            Property="TextColor"
                                            Value="{DynamicResource ExchangeMuted}" />

                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>