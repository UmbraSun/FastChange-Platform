<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Views.Sections.Home.MarketPreviewView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UI.ViewModels"
    x:DataType="viewModels:HomeViewModel">

    <Border
        Padding="18"
        BackgroundColor="{DynamicResource ExchangeCard}"
        Stroke="{DynamicResource ExchangeBorder}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 20">

        <VerticalStackLayout Spacing="16">

            <!-- Header -->
            <Label
                Text="Markets"
                FontFamily="{DynamicResource Headline}"
                FontSize="18"
                TextColor="{DynamicResource ExchangeText}" />

            <!-- Loading -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Color="{DynamicResource ExchangeGold}" />

            <!-- Error -->
            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding IsErrorVisible}"
                FontFamily="{DynamicResource Body}"
                FontSize="14"
                TextColor="#F6465D" />

            <!-- Empty -->
            <Label
                Text="No market data available."
                IsVisible="{Binding IsMarketsEmpty}"
                FontFamily="{DynamicResource Body}"
                FontSize="14"
                TextColor="{DynamicResource ExchangeMuted}" />

            <!-- Markets -->
            <VerticalStackLayout
                Spacing="14"
                BindableLayout.ItemsSource="{Binding Markets}"
                IsVisible="{Binding HasMarkets}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3">

                                <Label
                                    Text="{Binding Pair}"
                                    FontFamily="{DynamicResource Headline}"
                                    FontSize="15"
                                    TextColor="{DynamicResource ExchangeText}" />

                                <Label
                                    Text="{Binding DisplayPrice}"
                                    FontFamily="{DynamicResource Body}"
                                    FontSize="13"
                                    TextColor="{DynamicResource ExchangeMuted}" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="{Binding DisplayChange}"
                                FontFamily="{DynamicResource Body}"
                                FontSize="14"
                                HorizontalTextAlignment="End"
                                VerticalOptions="Center">

                                <Label.Triggers>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsPositive}"
                                        Value="True">

                                        <Setter
                                            Property="TextColor"
                                            Value="#0ECB81" />

                                    </DataTrigger>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsNegative}"
                                        Value="True">

                                        <Setter
                                            Property="TextColor"
                                            Value="#F6465D" />

                                    </DataTrigger>

                                    <DataTrigger
                                        TargetType="Label"
                                        Binding="{Binding IsNeutral}"
                                        Value="True">

                                        <Setter
                                            Property="TextColor"
                                            Value="{DynamicResource ExchangeMuted}" />

                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>