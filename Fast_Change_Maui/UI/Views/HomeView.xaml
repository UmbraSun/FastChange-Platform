<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Views.Sections.HomeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UI.ViewModels"
    x:DataType="viewModels:HomeViewModel"
    BackgroundColor="{DynamicResource ExchangeBg}">

    <Grid
        Padding="20,18,20,0"
        RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,24">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="4"
                VerticalOptions="Center">

                <Label
                    Text="{Binding UserName}"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="24"
                    LineBreakMode="TailTruncation"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="Manage your finances"
                    FontFamily="{DynamicResource Body}"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <Border
                Grid.Column="1"
                WidthRequest="46"
                HeightRequest="46"
                BackgroundColor="{DynamicResource ExchangeCard}"
                Stroke="{DynamicResource ExchangeBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 23"
                VerticalOptions="Center">

                <Label
                    Text="U"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="16"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="{DynamicResource ExchangeGold}" />

            </Border>

        </Grid>

        <!-- Total balance -->
        <Border
            Grid.Row="1"
            Padding="20"
            Margin="0,0,0,26"
            BackgroundColor="{DynamicResource ExchangeCard}"
            Stroke="{DynamicResource ExchangeBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18">

            <Grid RowDefinitions="Auto,Auto,Auto">

                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto">

                    <Label
                        Text="Total balance"
                        FontFamily="{DynamicResource Body}"
                        FontSize="14"
                        VerticalOptions="Center"
                        TextColor="{DynamicResource ExchangeMuted}" />

                    <Button
                        Grid.Column="1"
                        WidthRequest="36"
                        HeightRequest="36"
                        Text="•••"
                        Command="{Binding ToggleBalanceVisibilityCommand}"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        FontSize="17"
                        TextColor="{DynamicResource ExchangeMuted}" />

                </Grid>

                <Label
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Text="{Binding DisplayBalance}"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="36"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Grid.Row="2"
                    Margin="0,2,0,0"
                    Text="USD"
                    FontFamily="{DynamicResource Body}"
                    FontSize="13"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </Grid>

        </Border>

        <!-- Quick actions -->
        <VerticalStackLayout
            Grid.Row="2"
            Spacing="12"
            Margin="0,0,0,26">

            <Label
                Text="Quick actions"
                FontFamily="{DynamicResource Title}"
                FontSize="18"
                TextColor="{DynamicResource ExchangeText}" />

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="10">

                <Border
                    Grid.Column="0"
                    Padding="8,15"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout
                        Spacing="7"
                        HorizontalOptions="Center">

                        <Label
                            Text="⇄"
                            FontSize="23"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeGold}" />

                        <Label
                            Text="Exchange"
                            FontFamily="{DynamicResource Body}"
                            FontSize="12"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeText}" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Column="1"
                    Padding="8,15"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout
                        Spacing="7"
                        HorizontalOptions="Center">

                        <Label
                            Text="→"
                            FontSize="23"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeGold}" />

                        <Label
                            Text="Transfer"
                            FontFamily="{DynamicResource Body}"
                            FontSize="12"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeText}" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Column="2"
                    Padding="8,15"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout
                        Spacing="7"
                        HorizontalOptions="Center">

                        <Label
                            Text="+"
                            FontSize="23"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeGold}" />

                        <Label
                            Text="Deposit"
                            FontFamily="{DynamicResource Body}"
                            FontSize="12"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeText}" />

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </VerticalStackLayout>

        <!-- Wallets header -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,16">

            <Label
                Text="Wallets"
                FontFamily="{DynamicResource Title}"
                FontSize="18"
                TextColor="{DynamicResource ExchangeText}" />

            <Label
                Grid.Column="1"
                Text="View all"
                FontFamily="{DynamicResource Body}"
                FontSize="13"
                VerticalOptions="Center"
                TextColor="{DynamicResource ExchangeGold}" />

        </Grid>

        <!-- Wallet list -->
        <CollectionView
            Grid.Row="4"
            ItemsSource="{Binding Wallets}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="16"
                        Margin="0,0,0,9"
                        BackgroundColor="{DynamicResource ExchangeCard}"
                        Stroke="{DynamicResource ExchangeBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            VerticalOptions="Center">

                            <VerticalStackLayout
                                Spacing="4">

                                <Label
                                    Text="{Binding Currency}"
                                    FontFamily="{DynamicResource Title}"
                                    FontSize="16"
                                    TextColor="{DynamicResource ExchangeText}" />

                                <Label
                                    Text="Available balance"
                                    FontFamily="{DynamicResource Body}"
                                    FontSize="12"
                                    TextColor="{DynamicResource ExchangeMuted}" />

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                HorizontalOptions="End"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding Balance, StringFormat='{0:N2}'}"
                                    FontFamily="{DynamicResource Headline}"
                                    FontSize="17"
                                    HorizontalTextAlignment="End"
                                    TextColor="{DynamicResource ExchangeText}" />

                                <Label
                                    Text="{Binding Currency}"
                                    FontFamily="{DynamicResource Body}"
                                    FontSize="11"
                                    HorizontalTextAlignment="End"
                                    TextColor="{DynamicResource ExchangeMuted}" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentView>