<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Views.Sections.HomeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UI.ViewModels"
    xmlns:home="clr-namespace:UI.Views.Sections.Home"
    x:DataType="viewModels:HomeViewModel"
    BackgroundColor="{DynamicResource ExchangeBg}"
    Loaded="HomeView_Loaded"
    Unloaded="HomeView_Unloaded">

    <ScrollView
        Orientation="Vertical">

        <Grid
            Padding="20,18,20,24"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="24">

            <home:HomeHeaderView 
                x:Name="HeaderView"
                Grid.Row="0" />

            <home:BalanceCardView
                 Grid.Row="1" />

            <home:QuickActionsView
                x:Name="QuickActionsView"
                Grid.Row="2" />

            <home:WalletsPreviewView
                x:Name="WalletsPreviewView"
                Grid.Row="3" />

            <home:MarketPreviewView
                Grid.Row="4" />

            <home:RecentActivityView
                Grid.Row="5" />
            
        </Grid>
    </ScrollView>
</ContentView>
    