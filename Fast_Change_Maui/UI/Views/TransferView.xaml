<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Views.Sections.TransferView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UI.Controls"
    xmlns:viewModels="clr-namespace:UI.ViewModels"
    x:DataType="viewModels:TransferViewModel"
    BackgroundColor="{DynamicResource ExchangeBg}">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,18,20,24"
            Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">

                <Label
                    Text="Transfer"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="28"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="Send funds to another FastChange user"
                    FontFamily="{DynamicResource Body}"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <!-- From wallet -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="From wallet"
                    FontFamily="{DynamicResource Title}"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeText}" />

                <controls:WalletSelector
                    Wallets="{Binding Wallets}"
                    SelectedWallet="{Binding SelectedWallet, Mode=TwoWay}"
                    SelectorTitle="Wallet" />

            </VerticalStackLayout>

            <!-- Recipient -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="Recipient"
                    FontFamily="{DynamicResource Title}"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeText}" />

                <Border
                    Padding="16,2"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <Entry
                        Text="{Binding SearchQuery}"
                        Placeholder="Search by email"
                        ReturnType="Search"
                        ReturnCommand="{Binding SearchRecipientsCommand}"
                        FontFamily="{DynamicResource Body}"
                        FontSize="15"
                        TextColor="{DynamicResource ExchangeText}"
                        PlaceholderColor="{DynamicResource ExchangeMuted}"
                        BackgroundColor="Transparent" />

                </Border>

                <ActivityIndicator
                    IsRunning="{Binding IsSearching}"
                    IsVisible="{Binding IsSearching}"
                    HorizontalOptions="Center"
                    Color="{DynamicResource ExchangeGold}" />

                <!-- Selected recipient -->
                <Border
                    IsVisible="{Binding HasSelectedRecipient}"
                    Padding="14"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeGold}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="{Binding SelectedRecipient.Email}"
                                FontFamily="{DynamicResource Title}"
                                FontSize="15"
                                TextColor="{DynamicResource ExchangeText}" />

                            <Label
                                Text="{Binding SelectedRecipient.Currency}"
                                FontFamily="{DynamicResource Body}"
                                FontSize="12"
                                TextColor="{DynamicResource ExchangeMuted}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="✓"
                            FontSize="18"
                            VerticalOptions="Center"
                            TextColor="{DynamicResource ExchangeGold}" />

                    </Grid>

                </Border>

                <!-- Search results -->
                <CollectionView
                    ItemsSource="{Binding Recipients}"
                    SelectionMode="None"
                    IsVisible="{Binding HasRecipients}"
                    MaximumHeightRequest="220">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Padding="14"
                                Margin="0,0,0,8"
                                BackgroundColor="{DynamicResource ExchangeCard}"
                                Stroke="{DynamicResource ExchangeBorder}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="Recipient_Tapped" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto">

                                    <VerticalStackLayout Spacing="3">

                                        <Label
                                            Text="{Binding Email}"
                                            FontFamily="{DynamicResource Title}"
                                            FontSize="14"
                                            TextColor="{DynamicResource ExchangeText}" />

                                        <Label
                                            Text="{Binding Currency}"
                                            FontFamily="{DynamicResource Body}"
                                            FontSize="12"
                                            TextColor="{DynamicResource ExchangeMuted}" />

                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="›"
                                        FontSize="22"
                                        VerticalOptions="Center"
                                        TextColor="{DynamicResource ExchangeMuted}" />

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

            <!-- Amount -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="Amount"
                    FontFamily="{DynamicResource Title}"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeText}" />

                <Border
                    Padding="16,2"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <Grid ColumnDefinitions="*,Auto">

                        <Entry
                            Text="{Binding AmountText}"
                            Keyboard="Numeric"
                            Placeholder="0.00"
                            FontFamily="{DynamicResource Body}"
                            FontSize="20"
                            TextColor="{DynamicResource ExchangeText}"
                            PlaceholderColor="{DynamicResource ExchangeMuted}"
                            BackgroundColor="Transparent" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding SelectedWallet.Currency}"
                            FontFamily="{DynamicResource Title}"
                            FontSize="14"
                            VerticalOptions="Center"
                            TextColor="{DynamicResource ExchangeGold}" />

                    </Grid>

                </Border>

            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding IsErrorVisible}"
                FontFamily="{DynamicResource Body}"
                FontSize="13"
                TextColor="{DynamicResource ExchangeGold}" />

            <Label
                Text="{Binding SuccessMessage}"
                IsVisible="{Binding IsSuccessVisible}"
                FontFamily="{DynamicResource Body}"
                FontSize="13"
                TextColor="{DynamicResource ExchangeGold}" />

            <Button
                Text="Transfer"
                Command="{Binding TransferCommand}"
                HeightRequest="52"
                CornerRadius="14"
                BackgroundColor="{DynamicResource ExchangeGold}"
                TextColor="{DynamicResource ExchangeBg}"
                FontFamily="{DynamicResource Title}"
                FontSize="15" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Color="{DynamicResource ExchangeGold}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentView>