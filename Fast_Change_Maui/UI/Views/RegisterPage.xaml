<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="UI.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UI.ViewModels"
    x:DataType="viewModels:RegisterViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource ExchangeBg}">

    <ScrollView>
        <Grid
            Padding="24"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
            RowSpacing="18">

            <!-- Back -->
            <HorizontalStackLayout
                Grid.Row="0"
                Margin="0,16,0,12"
                Spacing="6">

                <Label
                    Text="‹"
                    FontSize="30"
                    TextColor="{DynamicResource ExchangeMuted}"
                    VerticalTextAlignment="Center" />

                <Label
                    Text="Back to sign in"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeMuted}"
                    VerticalTextAlignment="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding OpenLoginCommand}" />
                    </Label.GestureRecognizers>

                </Label>

            </HorizontalStackLayout>

            <!-- Header -->
            <VerticalStackLayout
                Grid.Row="1"
                Margin="0,20,0,8"
                Spacing="8">

                <Label
                    Text="FastChange"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource ExchangeGold}" />

                <Label
                    Text="Create your account"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="Register to start using FastChange."
                    FontSize="15"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <!-- Email -->
            <VerticalStackLayout
                Grid.Row="2"
                Spacing="8">

                <Label
                    Text="Email"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeText}" />

                <Entry
                    Text="{Binding Email}"
                    Placeholder="Enter your email"
                    Keyboard="Email"
                    ClearButtonVisibility="WhileEditing"
                    ReturnType="Next"
                    HeightRequest="52" />

            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout
                Grid.Row="3"
                Spacing="8">

                <Label
                    Text="Password"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeText}" />

                <Entry
                    Text="{Binding Password}"
                    Placeholder="Create a password"
                    IsPassword="True"
                    ReturnType="Next"
                    HeightRequest="52" />

            </VerticalStackLayout>

            <!-- Confirm password -->
            <VerticalStackLayout
                Grid.Row="4"
                Spacing="8">

                <Label
                    Text="Confirm password"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeText}" />

                <Entry
                    Text="{Binding ConfirmPassword}"
                    Placeholder="Repeat your password"
                    IsPassword="True"
                    ReturnType="Done"
                    HeightRequest="52" />

            </VerticalStackLayout>

            <!-- Bottom area -->
            <VerticalStackLayout
                Grid.Row="5"
                Spacing="12">

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#F6465D"
                    FontSize="14"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <Button
                    Text="Create account"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    HeightRequest="52"
                    CornerRadius="12"
                    BackgroundColor="{DynamicResource ExchangeGold}"
                    TextColor="{DynamicResource ExchangeBg}"
                    FontSize="16"
                    FontAttributes="Bold" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{DynamicResource ExchangeGold}"
                    HeightRequest="24" />

            </VerticalStackLayout>

            <!-- Terms -->
            <Label
                Grid.Row="6"
                Margin="0,8,0,20"
                Text="By creating an account, you agree to our Terms."
                TextColor="{DynamicResource ExchangeMuted}"
                FontSize="11"
                HorizontalTextAlignment="Center" />

        </Grid>
    </ScrollView>

</ContentPage>