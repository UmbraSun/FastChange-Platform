<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Views.Sections.WalletsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UI.ViewModels"
    x:DataType="viewModels:WalletsViewModel"
    BackgroundColor="{DynamicResource ExchangeBg}">

    <Grid
        Padding="20,18,20,0"
        RowDefinitions="Auto,*">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Margin="0,0,0,22"
            Spacing="5">

            <Label
                Text="Wallets"
                FontFamily="{DynamicResource Headline}"
                FontSize="28"
                TextColor="{DynamicResource ExchangeText}" />

            <Label
                Text="Your currency balances"
                FontFamily="{DynamicResource Body}"
                FontSize="14"
                TextColor="{DynamicResource ExchangeMuted}" />

        </VerticalStackLayout>

        <!-- Content states -->
        <Grid Grid.Row="1">

            <!-- Loading -->
            <VerticalStackLayout
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    Color="{DynamicResource ExchangeGold}" />

                <Label
                    Text="Loading wallets..."
                    FontFamily="{DynamicResource Body}"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <!-- Error -->
            <VerticalStackLayout
                IsVisible="{Binding IsErrorVisible}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="8">

                <Label
                    Text="Unable to load wallets"
                    FontFamily="{DynamicResource Title}"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="{Binding ErrorMessage}"
                    FontFamily="{DynamicResource Body}"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <!-- Empty -->
            <VerticalStackLayout
                IsVisible="{Binding IsEmptyVisible}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="8">

                <Label
                    Text="No wallets yet"
                    FontFamily="{DynamicResource Title}"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="Your currency wallets will appear here."
                    FontFamily="{DynamicResource Body}"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <!-- Wallet list -->
            <CollectionView
                IsVisible="{Binding IsContentVisible}"
                ItemsSource="{Binding Wallets}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="18"
                            Margin="0,0,0,10"
                            BackgroundColor="{DynamicResource ExchangeCard}"
                            Stroke="{DynamicResource ExchangeBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="14">

                                <!-- Currency badge -->
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="{DynamicResource ExchangeBg}"
                                    Stroke="{DynamicResource ExchangeBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 22"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Currency}"
                                        FontFamily="{DynamicResource Headline}"
                                        FontSize="12"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        TextColor="{DynamicResource ExchangeGold}" />

                                </Border>

                                <!-- Wallet information -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Currency}"
                                        FontFamily="{DynamicResource Title}"
                                        FontSize="16"
                                        TextColor="{DynamicResource ExchangeText}" />

                                    <Label
                                        Text="Available balance"
                                        FontFamily="{DynamicResource Body}"
                                        FontSize="12"
                                        TextColor="{DynamicResource ExchangeMuted}" />

                                </VerticalStackLayout>

                                <!-- Balance -->
                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="2"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Balance, StringFormat='{0:N2}'}"
                                        FontFamily="{DynamicResource Headline}"
                                        FontSize="17"
                                        HorizontalTextAlignment="End"
                                        TextColor="{DynamicResource ExchangeText}" />

                                    <Label
                                        Text="{Binding Currency}"
                                        FontFamily="{DynamicResource Body}"
                                        FontSize="11"
                                        HorizontalTextAlignment="End"
                                        TextColor="{DynamicResource ExchangeMuted}" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

    </Grid>

</ContentView>