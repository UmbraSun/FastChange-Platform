<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Views.Sections.ProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UI.ViewModels"
    x:DataType="viewModels:ProfileViewModel"
    BackgroundColor="{DynamicResource ExchangeBg}">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,18,20,24"
            Spacing="20">

            <!-- Header -->

            <VerticalStackLayout
                Spacing="5"
                Margin="0,0,0,4">

                <Label
                    Text="Profile"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="28"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="Manage your account"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <!-- User -->

            <Border
                Padding="18"
                BackgroundColor="{DynamicResource ExchangeCard}"
                Stroke="{DynamicResource ExchangeBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="16">

                    <Border
                        WidthRequest="56"
                        HeightRequest="56"
                        BackgroundColor="{DynamicResource ExchangeBg}"
                        Stroke="{DynamicResource ExchangeBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28">

                        <Label
                            Text="{Binding Initial}"
                            FontFamily="{DynamicResource Headline}"
                            FontSize="22"
                            TextColor="{DynamicResource ExchangeGold}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="5"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding Email}"
                            FontFamily="{DynamicResource Title}"
                            FontSize="16"
                            TextColor="{DynamicResource ExchangeText}" />

                        <Label
                            Text="{Binding VerificationStatus}"
                            FontSize="13"
                            TextColor="{DynamicResource ExchangeMuted}" />

                    </VerticalStackLayout>

                </Grid>

            </Border>

            <!-- Account -->

            <VerticalStackLayout Spacing="10">

                <Label
                    Text="Account"
                    FontFamily="{DynamicResource Title}"
                    FontSize="18"
                    TextColor="{DynamicResource ExchangeText}" />

                <Border
                    Padding="16"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Email"
                                FontSize="13"
                                TextColor="{DynamicResource ExchangeMuted}" />

                            <Label
                                Text="{Binding Email}"
                                FontSize="15"
                                TextColor="{DynamicResource ExchangeText}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

            </VerticalStackLayout>

            <!-- Session -->

            <VerticalStackLayout Spacing="10">

                <Label
                    Text="Session"
                    FontFamily="{DynamicResource Title}"
                    FontSize="18"
                    TextColor="{DynamicResource ExchangeText}" />

                <Button
                    Text="Sign out"
                    Command="{Binding LogoutCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    HeightRequest="52"
                    CornerRadius="12"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    BorderColor="{DynamicResource ExchangeBorder}"
                    BorderWidth="1"
                    TextColor="#F6465D"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="15" />

            </VerticalStackLayout>

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Color="{DynamicResource ExchangeGold}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                FontSize="13"
                TextColor="#F6465D" />

        </VerticalStackLayout>

    </ScrollView>

</ContentView>