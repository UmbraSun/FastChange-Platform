<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Views.Sections.ProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:UI.ViewModels"
    x:DataType="viewModels:ProfileViewModel"
    BackgroundColor="{DynamicResource ExchangeBg}">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,18,20,24"
            Spacing="22">

            <!-- Header -->
            <VerticalStackLayout
                Spacing="5"
                Margin="0,0,20,0">

                <Label
                    Text="Profile"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="28"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="Manage your account"
                    FontFamily="{DynamicResource Body}"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <!-- User card -->
            <Border
                Padding="18"
                BackgroundColor="{DynamicResource ExchangeCard}"
                Stroke="{DynamicResource ExchangeBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="16">

                    <!-- Avatar -->
                    <Border
                        Grid.Column="0"
                        WidthRequest="58"
                        HeightRequest="58"
                        BackgroundColor="{DynamicResource ExchangeBg}"
                        Stroke="{DynamicResource ExchangeBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 29"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding Initial}"
                            FontFamily="{DynamicResource Headline}"
                            FontSize="22"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            TextColor="{DynamicResource ExchangeGold}" />

                    </Border>

                    <!-- User information -->
                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding Email}"
                            FontFamily="{DynamicResource Title}"
                            FontSize="16"
                            LineBreakMode="TailTruncation"
                            TextColor="{DynamicResource ExchangeText}" />

                        <Border
                            Padding="9,4"
                            HorizontalOptions="Start"
                            BackgroundColor="{DynamicResource ExchangeBg}"
                            Stroke="{DynamicResource ExchangeBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8">

                            <Label
                                Text="{Binding VerificationStatus}"
                                FontFamily="{DynamicResource Body}"
                                FontSize="11"
                                TextColor="{DynamicResource ExchangeGold}" />

                        </Border>

                    </VerticalStackLayout>

                </Grid>

            </Border>

            <!-- Account -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="Account"
                    FontFamily="{DynamicResource Title}"
                    FontSize="18"
                    TextColor="{DynamicResource ExchangeText}" />

                <Border
                    Padding="16"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout
                        Spacing="5">

                        <Label
                            Text="Email"
                            FontFamily="{DynamicResource Body}"
                            FontSize="12"
                            TextColor="{DynamicResource ExchangeMuted}" />

                        <Label
                            Text="{Binding Email}"
                            FontFamily="{DynamicResource Body}"
                            FontSize="15"
                            LineBreakMode="TailTruncation"
                            TextColor="{DynamicResource ExchangeText}" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <!-- Session -->
            <VerticalStackLayout
                Spacing="10">

                <Label
                    Text="Session"
                    FontFamily="{DynamicResource Title}"
                    FontSize="18"
                    TextColor="{DynamicResource ExchangeText}" />

                <Button
                    Text="Sign out"
                    Command="{Binding LogoutCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    HeightRequest="52"
                    CornerRadius="12"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    BorderColor="{DynamicResource ExchangeBorder}"
                    BorderWidth="1"
                    TextColor="#F6465D"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="15" />

            </VerticalStackLayout>

            <!-- Loading -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Color="{DynamicResource ExchangeGold}" />

            <!-- Error -->
            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                FontFamily="{DynamicResource Body}"
                FontSize="13"
                TextColor="#F6465D" />

        </VerticalStackLayout>

    </ScrollView>

</ContentView>