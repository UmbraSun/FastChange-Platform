<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource ExchangeBg}"
    Shell.NavBarIsVisible="False">

    <Grid
        Padding="20,18,20,0"
        RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,28">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="4">

                <Label
                    Text="{Binding UserName}"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="24"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="Manage your finances"
                    FontFamily="{DynamicResource Body}"
                    FontSize="14"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

            <Border
                Grid.Column="1"
                WidthRequest="44"
                HeightRequest="44"
                StrokeThickness="1"
                Stroke="{DynamicResource ExchangeBorder}"
                BackgroundColor="{DynamicResource ExchangeCard}"
                StrokeShape="RoundRectangle 22">

                <Label
                    Text="U"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="16"
                    TextColor="{DynamicResource ExchangeText}" />

            </Border>

        </Grid>

        <!-- Balance -->
        <Border
            Grid.Row="1"
            Padding="20"
            Margin="0,0,0,24"
            BackgroundColor="{DynamicResource ExchangeCard}"
            Stroke="{DynamicResource ExchangeBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18">

            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="*,Auto">

                    <Label
                        Text="Total balance"
                        FontFamily="{DynamicResource Body}"
                        FontSize="14"
                        TextColor="{DynamicResource ExchangeMuted}" />

                    <Button
                        Grid.Column="1"
                        Text="•••"
                        Command="{Binding ToggleBalanceVisibilityCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource ExchangeMuted}"
                        Padding="8,0"
                        FontSize="18" />

                </Grid>

                <Label
                    Text="—"
                    FontFamily="{DynamicResource Headline}"
                    FontSize="34"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Text="USD"
                    FontFamily="{DynamicResource Body}"
                    FontSize="13"
                    TextColor="{DynamicResource ExchangeMuted}" />

            </VerticalStackLayout>

        </Border>

        <!-- Quick actions -->
        <VerticalStackLayout
            Grid.Row="2"
            Spacing="12"
            Margin="0,0,0,28">

            <Label
                Text="Quick actions"
                FontFamily="{DynamicResource Title}"
                FontSize="18"
                TextColor="{DynamicResource ExchangeText}" />

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="10">

                <Border
                    Grid.Column="0"
                    Padding="10,16"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="↔"
                            FontSize="24"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeGold}" />

                        <Label
                            Text="Exchange"
                            FontSize="13"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeText}" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Column="1"
                    Padding="10,16"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="→"
                            FontSize="24"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeGold}" />

                        <Label
                            Text="Transfer"
                            FontSize="13"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeText}" />

                    </VerticalStackLayout>

                </Border>

                <Border
                    Grid.Column="2"
                    Padding="10,16"
                    BackgroundColor="{DynamicResource ExchangeCard}"
                    Stroke="{DynamicResource ExchangeBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="+"
                            FontSize="24"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeGold}" />

                        <Label
                            Text="Deposit"
                            FontSize="13"
                            HorizontalOptions="Center"
                            TextColor="{DynamicResource ExchangeText}" />

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </VerticalStackLayout>

        <!-- Wallets -->
        <VerticalStackLayout
            Grid.Row="3"
            Spacing="12"
            Margin="0,0,0,20">

            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Text="Wallets"
                    FontFamily="{DynamicResource Title}"
                    FontSize="18"
                    TextColor="{DynamicResource ExchangeText}" />

                <Label
                    Grid.Column="1"
                    Text="View all"
                    FontSize="13"
                    TextColor="{DynamicResource ExchangeGold}" />

            </Grid>

        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="4"
            Spacing="10">

            <CollectionView
                ItemsSource="{Binding Wallets}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16"
                            Margin="0,0,0,8"
                            BackgroundColor="{DynamicResource ExchangeCard}"
                            Stroke="{DynamicResource ExchangeBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="3">

                                    <Label
                                        Text="{Binding Currency}"
                                        FontFamily="{DynamicResource Title}"
                                        FontSize="16"
                                        TextColor="{DynamicResource ExchangeText}" />

                                    <Label
                                        Text="Available balance"
                                        FontSize="12"
                                        TextColor="{DynamicResource ExchangeMuted}" />

                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Balance, StringFormat='{0:N2}'}"
                                    FontFamily="{DynamicResource Headline}"
                                    FontSize="17"
                                    VerticalOptions="Center"
                                    TextColor="{DynamicResource ExchangeText}" />

                            </Grid>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                FontSize="13"
                TextColor="#F6465D" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>