<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Controls.BottomNavigation"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource ExchangeCard}">

    <Border
        Margin="0"
        Padding="8,8,8,10"
        BackgroundColor="{DynamicResource ExchangeCard}"
        Stroke="{DynamicResource ExchangeBorder}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 20,20,0,0">

        <Grid
            ColumnDefinitions="*,*,*,*,*"
            ColumnSpacing="2">

            <!-- Home -->

            <Grid Grid.Column="0" RowDefinitions="Auto,Auto">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Home_Tapped" />
                </Grid.GestureRecognizers>

                <Label
                    Grid.Row="0"
                    Text="⌂"
                    FontSize="21"
                    HorizontalOptions="Center"
                    TextColor="{Binding HomeColor}" />

                <Label
                    Grid.Row="1"
                    Text="Home"
                    FontSize="10"
                    Margin="0,3,0,0"
                    HorizontalOptions="Center"
                    TextColor="{Binding HomeColor}" />

            </Grid>

            <!-- Wallets -->

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Wallets_Tapped" />
                </Grid.GestureRecognizers>

                <Label
                    Grid.Row="0"
                    Text="▣"
                    FontSize="20"
                    HorizontalOptions="Center"
                    TextColor="{Binding WalletsColor}" />

                <Label
                    Grid.Row="1"
                    Text="Wallets"
                    FontSize="10"
                    Margin="0,3,0,0"
                    HorizontalOptions="Center"
                    TextColor="{Binding WalletsColor}" />

            </Grid>

            <!-- Exchange -->

            <Grid Grid.Column="2" RowDefinitions="Auto,Auto">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Exchange_Tapped" />
                </Grid.GestureRecognizers>

                <Label
                    Grid.Row="0"
                    Text="⇄"
                    FontSize="21"
                    HorizontalOptions="Center"
                    TextColor="{Binding ExchangeColor}" />

                <Label
                    Grid.Row="1"
                    Text="Exchange"
                    FontSize="10"
                    Margin="0,3,0,0"
                    HorizontalOptions="Center"
                    TextColor="{Binding ExchangeColor}" />

            </Grid>

            <!-- History -->

            <Grid Grid.Column="3" RowDefinitions="Auto,Auto">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="History_Tapped" />
                </Grid.GestureRecognizers>

                <Label
                    Grid.Row="0"
                    Text="◷"
                    FontSize="21"
                    HorizontalOptions="Center"
                    TextColor="{Binding HistoryColor}" />

                <Label
                    Grid.Row="1"
                    Text="History"
                    FontSize="10"
                    Margin="0,3,0,0"
                    HorizontalOptions="Center"
                    TextColor="{Binding HistoryColor}" />

            </Grid>

            <!-- Profile -->

            <Grid Grid.Column="4" RowDefinitions="Auto,Auto">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Profile_Tapped" />
                </Grid.GestureRecognizers>

                <Label
                    Grid.Row="0"
                    Text="◉"
                    FontSize="21"
                    HorizontalOptions="Center"
                    TextColor="{Binding ProfileColor}" />

                <Label
                    Grid.Row="1"
                    Text="Profile"
                    FontSize="10"
                    Margin="0,3,0,0"
                    HorizontalOptions="Center"
                    TextColor="{Binding ProfileColor}" />

            </Grid>

        </Grid>

    </Border>

</ContentView>