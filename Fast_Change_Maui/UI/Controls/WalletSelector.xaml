<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="UI.Controls.WalletSelector"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid RowDefinitions="Auto,Auto">

        <Border
            Grid.Row="0"
            Padding="14,12"
            BackgroundColor="{DynamicResource ExchangeCard}"
            Stroke="{DynamicResource ExchangeBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 14">

            <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="SelectedWallet_Tapped" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*,Auto">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="3">

                    <Label
                        Text="{Binding SelectorTitle,
                               Source={x:Reference Root}}"
                        FontSize="12"
                        TextColor="{DynamicResource ExchangeMuted}" />

                    <Label
                        Text="{Binding SelectedWallet.Currency,
                               Source={x:Reference Root}}"
                        FontFamily="{DynamicResource Headline}"
                        FontSize="17"
                        TextColor="{DynamicResource ExchangeText}" />

                    <Label
                        Text="{Binding SelectedWallet.Balance,
                               Source={x:Reference Root},
                               StringFormat='Balance: {0:N2}'}"
                        FontSize="12"
                        TextColor="{DynamicResource ExchangeMuted}" />

                </VerticalStackLayout>

                <Label
                    Grid.Column="1"
                    Margin="16,0,2,0"
                    Text="⌄"
                    FontSize="20"
                    TextColor="{DynamicResource ExchangeMuted}"
                    VerticalOptions="Center">

                    <Label.Triggers>
                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding IsExpanded,
                                      Source={x:Reference Root}}"
                            Value="True">

                            <Setter
                                Property="Text"
                                Value="⌃" />

                        </DataTrigger>
                    </Label.Triggers>

                </Label>

            </Grid>

        </Border>

        <Border
            Grid.Row="1"
            Margin="0,6,0,0"
            Padding="4"
            BackgroundColor="{DynamicResource ExchangeCard}"
            IsVisible="{Binding IsExpanded,
                                Source={x:Reference Root}}"
            Stroke="{DynamicResource ExchangeBorder}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 14">

            <CollectionView
                ItemsSource="{Binding Wallets,
                                      Source={x:Reference Root}}"
                SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Grid Padding="12,11">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="WalletItem_Tapped"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <VerticalStackLayout
                                Spacing="2">

                                <Label
                                    Text="{Binding Currency}"
                                    FontFamily="{DynamicResource Headline}"
                                    FontSize="15"
                                    TextColor="{DynamicResource ExchangeText}" />

                                <Label
                                    Text="{Binding Balance,
                                           StringFormat='Balance: {0:N2}'}"
                                    FontSize="12"
                                    TextColor="{DynamicResource ExchangeMuted}" />

                            </VerticalStackLayout>

                        </Grid>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Border>

    </Grid>

</ContentView>