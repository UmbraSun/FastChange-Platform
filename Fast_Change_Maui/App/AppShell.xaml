<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:UI.Views;assembly=UI"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent
        Route="register"
        ContentTemplate="{DataTemplate views:RegisterPage}" />

    <ShellContent
        Route="dashboard"
        ContentTemplate="{DataTemplate views:DashboardPage}" />

    <ShellContent
        Route="wallets"
        ContentTemplate="{DataTemplate views:WalletsPage}" />

    <ShellContent
        Route="exchange"
        ContentTemplate="{DataTemplate views:ExchangePage}" />

</Shell>